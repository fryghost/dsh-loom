# Normalize line endings in the repository regardless of the contributor's
# platform, so the committed bundle and sources are byte-stable across the
# Windows/macOS/Linux machines this plugin is installed on.
* text=auto

# The generated client bundle is a build artifact; treat it as text so diffs
# stay readable, but never let a platform convert it differently from source.
dist/client.js text eol=lf

*.cjs text eol=lf
*.js  text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.md text eol=lf

# Binary assets must never be normalized.
*.png binary
*.jpg binary
*.gif binary
*.webp binary
